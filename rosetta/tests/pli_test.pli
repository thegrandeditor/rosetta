*PROCESS;
 HELLO: PROCEDURE OPTIONS(MAIN);
   DECLARE NAME CHARACTER(20) VARYING;
   DECLARE I FIXED BINARY;
   DECLARE A(10) FLOAT;
   DECLARE P POINTER;
   DECLARE MY_TASK TASK;

   ON ERROR PUT LIST('AN ERROR OCCURRED');

   GET LIST(NAME);
   PUT LIST('HELLO ', NAME);

   DO I = 1 TO 10;
     A(I) = I * 1.1;
   END;

   ALLOCATE FLOAT SET(P);
   FREE P;

   CALL SUB1(A(5));

   SUB1: PROCEDURE(X);
     DECLARE X FLOAT;
     PUT LIST('X IS ', X);
   END SUB1;

 END HELLO;
